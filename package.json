{
  "name": "vibebot-studio",
  "displayName": "VibeBot Studio",
  "description": "Live MAVLink telemetry, AI diagnostics and drone/robotics developer tools — inside VS Code. No hardware needed to get started.",
  "version": "0.1.3",
  "icon": "resources/icon.png",
  "publisher": "vibebot",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/octaboomai/VibeBot"
  },
  "homepage": "https://github.com/octaboomai/VibeBot#readme",
  "bugs": {
    "url": "https://github.com/octaboomai/VibeBot/issues"
  },
  "engines": {
    "vscode": "^1.136.0"
  },
  "categories": [
    "Visualization",
    "Debuggers",
    "Other"
  ],
  "keywords": [
    "drone",
    "robotics",
    "mavlink",
    "telemetry",
    "ardupilot",
    "px4",
    "ros2",
    "sitl",
    "uav",
    "autopilot",
    "flight controller",
    "imu",
    "gps",
    "attitude",
    "ai",
    "embedded"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vibebot-sidebar",
          "title": "VibeBot Studio",
          "icon": "resources/icon.png"
        }
      ]
    },
    "views": {
      "vibebot-sidebar": [
        {
          "type": "webview",
          "id": "vibebot.telemetryView",
          "name": "Telemetry"
        }
      ]
    },
    "commands": [
      {
        "command": "vibebot.connectMAVLink",
        "title": "VibeBot: Connect to Drone (MAVLink)",
        "icon": "$(plug)"
      },
      {
        "command": "vibebot.disconnect",
        "title": "VibeBot: Disconnect",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "vibebot.importFlightLog",
        "title": "VibeBot: Import Flight Log (.bin / .ulg)",
        "icon": "$(file-add)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "vibebot.connectMAVLink",
          "when": "view == vibebot.telemetryView",
          "group": "navigation@1"
        },
        {
          "command": "vibebot.importFlightLog",
          "when": "view == vibebot.telemetryView",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "VibeBot Studio",
      "properties": {
        "vibebot.pythonPath": {
          "type": "string",
          "default": "python3",
          "description": "Path to Python interpreter with pymavlink installed. On Windows use the full path e.g. C:\\Users\\HP\\AppData\\Local\\Programs\\Python\\Python314\\python.exe"
        },
        "vibebot.defaultHost": {
          "type": "string",
          "default": "127.0.0.1",
          "description": "Default drone IP address (127.0.0.1 = PX4/ArduPilot SITL on localhost)"
        },
        "vibebot.defaultPort": {
          "type": "number",
          "default": 14550,
          "description": "Default MAVLink UDP port (14550 = QGroundControl standard)"
        },
        "vibebot.telemetryRateHz": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "maximum": 50,
          "description": "How often the telemetry dashboard refreshes (Hz)"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "vscode:prepublish": "node esbuild.js --production",
    "typecheck": "tsc --noEmit && tsc --noEmit -p webview/tsconfig.json",
    "package": "npx @vscode/vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/vscode": "^1.136.0",
    "esbuild": "^0.20.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
